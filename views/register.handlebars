<!DOCTYPE HTML>
<html>
<head>
	<meta charset="utf-8">
	<title>notenote</title>
	<link href="css/base.css" rel="stylesheet">
	<link href="css/font-awesome.min.css" rel="stylesheet">
	<link href="css/lemonade.min.css" rel="stylesheet">
	<link href='http://fonts.googleapis.com/css?family=Montserrat|Open+Sans:400,700' rel='stylesheet' type='text/css'>
</head>
<body>
	<main>
		<section class="head full">
			<div class="container">
				<a href="/"><div class="bit-2 left">
					<i class="fa fa-pencil fa-2x"></i>
					<h1 class="m">notenote</h1>
					<p>- share knowledge -</p><br>
				</div></a>
				<div class="bit-2 right">
					<form method="POST" action="/signin">
						<p class="m login">New Account</p>
						<input type="text" placeholder="username" class="text" name="username">
						<input type="password" placeholder="password" class="text" name="password">
						<input type="password" placeholder="confirm password" class="text" name="password2">
						<input type="email" placeholder="email" class="text" name="email">
						<input type="text" placeholder="school" class="text" name="school">
						<input type="text" placeholder="real name" class="text" name="realname">
						<input type="submit" class="button">
						<p class="or">or</p>
						<a class="button" href="">Login</a>
					</form>
				</div>
			</div>
		</section>
	</main>
</body>
</html>