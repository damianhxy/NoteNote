<div class="card searchbar"><i class="fa fa-search"></i><input type="text" placeholder="Search for notes..."><a href="#"><i class="fa fa-arrow-right"></i></a></div>
<div class="card profile">
	<div class="cardpic" style="background-color:{{user.icon}}"></div>
	<p class="cardname">{{theuser.username}}</p>
	<p class="cardinfo">{{theuser.realname}}</p>
	<p class="cardinfo"><span id="karmacount">{{theuser.karma}}</span> karma | <span id="followercount">{{followerCount}}</span> followers | following {{followeeCount}}</p>
	{{#isEqual user.username theuser.username}}{{else}}
		<a href="" class="cardfollow" data-fvalue="1" data-ftoggle="{{isFollower}}" data-ftarget="{{theuser.username}}">Follow</a>
	{{/isEqual}}
</div>
<div class="cardcont">
	{{#if posts}}
	{{#each posts}}
	<div class="card" data-ID="{{this.id}}">
		<p class="carddate">{{this.date}}</p>
		<p class="cardcaption">{{this.text}}</p>
		<a class="cardpreview {{this.extension}}" href="{{this.path}}" download="{{this.original}}">
			<i class="fa {{fileType this.extension}}"></i>
			<span> {{this.original}}</span>
		</a>
		<div class="cardtags">
			<span>Tags: </span>
			{{#each this.tags}}
			<a href="/search?query={{this}}">{{this}}</a>
			{{/each}}
		</div>
		<div class="cardcontrols">
			<span>{{this.karma}}</span>
			<a class="cardup" data-value="1" data-toggle="{{isInside ../user.username this.votes '1'}}" href="#"><i class="fa fa-arrow-up"></i></a>
			<a class="carddown" data-value="-1" data-toggle="{{isInside ../user.username this.votes '-1'}}" href="#"><i class="fa fa-arrow-down"></i></a>
			<a class="cardcomment" href="#"><i class="fa fa-comment"></i></a>
		</div>
		{{#isEqual ../user.username this.user}}
		<a href="#" class="close"><i class="fa fa-close"></i></a>
		{{/isEqual}}
	</div>
	{{/each}}
	{{else}}

	{{/if}}
</div>