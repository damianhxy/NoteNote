<div class="card searchbar"><i class="fa fa-search"></i><input type="text" placeholder="Search for notes..."><a href="#"><i class="fa fa-arrow-right"></i></a></div>
<div class="card profile">
	<div class="cardpic" style="background: url(https://api.adorable.io/avatars/150/{{user.username}}.png) center no-repeat"></div>
	<p class="cardname">{{profileUser.username}}</p>
	<p class="cardinfo">{{profileUser.realname}}</p>
	<p class="cardinfo"><span id="karmacount">{{profileUser.karma}}</span> karma | <span id="followercount">{{followerCount}}</span> followers | following {{followingCount}}</p>
	{{#isEqual user.username profileUser.username}}{{else}}
		<a href="" class="cardfollow" data-fvalue="1" data-ftoggle="{{isFollower}}" data-ftarget="{{profileUser.username}}">Follow</a>
	{{/isEqual}}
</div>
<div class="cardcont">
	{{#if posts}}
	{{#each posts}}
	{{> post this}}
	{{/each}}
	{{else}}
	<div class="card load">There are no notes</div>
	{{/if}}
</div>
