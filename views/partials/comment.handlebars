<div class="cardcom">
    <div class="compic" style="background-image: url(/media/avatar.svg)"></div>
    <a href="/users/{{this.username}}" class="comname">{{this.username}}</a>
    <p class="comdate">{{this.datePretty}}</p>
    <p class="comcontent">{{this.content}}</p>
    {{#isEqual user.username this.username}}<i class="close com" data-index="{{@index}}"><i class="fa fa-close"></i></i>{{/isEqual}}
</div>
