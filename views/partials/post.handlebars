<div class="card" data-ID="{{this._id}}">
    <div class="cardpic" style="background:url(https://api.adorable.io/avatars/285/{{this.username}}.png) center no-repeat;background-size:cover"></div>
    <p class="cardname">
        <a href="/profile/{{this.username}}">{{this.username}}</a>
    </p>
    <p class="carddate">{{this.date}}</p>
    <p class="cardcaption">{{this.body}}</p>
    <a class="cardpreview" href="{{this.path}}">
        <i class="fa {{fileType this.path}}"></i>
        <span>{{this.name}}</span>
    </a>
    <div class="cardtags">
        <span>Tags: </span>
        {{#each this.tags}}
        <a href="/search?query={{this}}">{{this}}</a>
        {{/each}}
    </div>
    <div class="cardcontrols">
        <span>{{this.karma}}</span>
        <a class="cardup" data-type="upvotes" data-toggle="{{isInside ../user.username this.upvotes}}" href="#"><i class="fa fa-arrow-up"></i></a>
        <a class="carddown" data-type="downvotes" data-toggle="{{isInside ../user.username this.downvotes}}" href="#"><i class="fa fa-arrow-down"></i></a>
        <a class="cardlink" href="/posts/perma/{{this._id}}"><i class="fa fa-link"></i></a>
    </div>
    <div class="cardcomments">
        {{#if comments}}
        {{#each comments}}
        <div class="cardcom">
            <div class="compic" style="background:{{this.icon}}"></div>
            <a href="/profile/{{this.user}}" class="comname">{{this.user}}</a>
            <p class="comdate">{{this.date}}</p>
            <p class="comcontent">{{this.text}}</p>
            {{#isEqual ../../user.username this.user}}<a href="#" class="comclose" data-dtarget="{{../this.id}}"><i class="fa fa-close"></i></a>{{/isEqual}}
        </div>
        {{/each}}
        {{/if}}
    </div>
    <div class="cardcom">
        <textarea placeholder="Leave a comment..."></textarea>
        <a href="#" class="comsubmit" data-ctarget="{{this.id}}">Add Comment <i class="fa fa-arrow-right"></i></a>
    </div>
    {{#isEqual ../user.username ../profileUser.username}}
    <a href="#" class="close"><i class="fa fa-close"></i></a>
    {{/isEqual}}
</div>
