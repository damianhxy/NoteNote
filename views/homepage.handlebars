<div class="cardcont">
	<div class="card searchbar"><form method="GET" action="/search"><i class="fa fa-search"></i><input type="text" placeholder="Search for notes..." name="query"><a href="#" onclick="document.forms[0].submit()"><i class="fa fa-arrow-right"></i></a></form></div>
	{{#if posts}}
	{{#each posts}}
	<div class="card" data-ID="{{this.id}}">
		<div class="cardpic" style="background:#{{this.icon}}"></div>
		<p class="cardname"><a href="/profile/{{this.user}}">{{this.user}}</a></p>
		<p class="carddate">{{this.date}}</p>
		<p class="cardcaption">{{this.text}}</p>
		<a class="cardpreview {{this.extension}}" href="{{this.path}}" download="{{this.original}}">
			<i class="fa {{fileType this.extension}}"></i>
			<span> {{this.original}}</span>
		</a>
		<div class="cardtags">
			<span>Tags: </span>
			{{#each this.tags}}
			<a href="/search?query={{this}}">{{this}}</a>
			{{/each}}
		</div>
		<div class="cardcontrols">
			<span>{{this.karma}}</span>
			<a class="cardup" data-value="1" data-toggle="{{isInside ../user.username this.votes '1'}}" href="#"><i class="fa fa-arrow-up"></i></a>
			<a class="carddown" data-value="-1" data-toggle="{{isInside ../user.username this.votes '-1'}}" href="#"><i class="fa fa-arrow-down"></i></a>
			<a class="cardcomment" href="#"><i class="fa fa-comment"></i></a>
		</div>
	</div>
	{{/each}}
	{{else}}

	{{/if}}
</div>
<div class="card load"><i class="fa fa-spinner"></i> Load More Submissions</div>