<div class="card add">
	<form method="POST" action="/addpost" enctype="multipart/form-data">
		<p class="addnew"><i class="fa fa-plus"></i> Upload Notes</p>
		<textarea class="addtext" placeholder="What're these notes about?" name="text"></textarea>
		<input type="file" class="addfile" id="af" name="file" required>
		<a href="#" id="fakeaf" class="addbutton">Upload File...</a><span class="addfilename">Your file name will appear here</span>
		<input type="text" class="addtext" placeholder="Tag your notes (comma separated)" name="tags">
		<input type="submit" class="addbutton" value="Upload">
	</form>
</div>