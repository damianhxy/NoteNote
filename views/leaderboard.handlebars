<div class="card table">
	<table>
	<thead>
		<tr>
			<th>Ranking</th>
			<th>Username</th>
			<th>Karma</th>
		</tr>
	</thead>
	<tbody>
		{{#each users}}
		<tr>
			<td>{{this.rank}}</td>
			<td><a href="/profile/{{this.username}}">{{this.username}}</a></td>
			<td>{{this.karma}}</td>
		</tr>
		{{/each}}
	</tbody>
	</table>
</div>